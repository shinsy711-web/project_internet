# 확정 도메인 — 사이트 A · B 가 다르다. 나누지 않으면 B 의 canonical·sitemap 이 A 도메인을 가리킨다
# A 는 jalkkalda.kr 확정 — 코드(lib/site.ts CONFIG.A.domain)에 들어 있어 비워 둬도 된다. 바꿀 때만 넣는다
NEXT_PUBLIC_SITE_URL=https://jalkkalda.kr
NEXT_PUBLIC_SITE_URL_B=

# 상담 폼 DB 수집 서버 (project21_db 공용 — project31 등과 같은 서버)
NEXT_PUBLIC_DB_SUBMIT_URL=https://project-db-bd.vercel.app/api/submit

# 사이트별 API 키 — project21_db 의 sites 테이블에 사이트 A · B 를 각각 등록해 받는다
# A 키는 lib/site.ts 에 기본값으로 들어 있다(jalkkalda.kr). 바꿀 때만 넣는다
NEXT_PUBLIC_DB_API_KEY=83072aae-c8e3-46e1-b95f-6a4ade83966e
NEXT_PUBLIC_DB_API_KEY_B=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_NAVER_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
